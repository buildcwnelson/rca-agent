# Google AI Studio API Key (Get your key from: https://aistudio.google.com/app/apikey)
GEMINI_API_KEY=

# Optional alternative key variable recognized by the Google GenAI SDK
GOOGLE_API_KEY=

# Optional: Default Gemini model (e.g. gemini-2.5-flash, gemini-2.5-pro, gemini-2.0-flash)
GEMINI_MODEL=gemini-2.5-flash

# Optional: Repository path to analyze (defaults to current directory if blank)
RCA_REPO_PATH=
